# Local development uses the real durable services. Keep demo mode disabled
# when testing project history, snapshots, Ask records, and Cloud Storage.
GAPSWISE_DEMO_MODE=false
USE_FIRESTORE=true
# Only this verified Google account receives full production access. Every
# other external account is limited to the public demo.
GAPSWISE_FULL_ACCESS_EMAILS=martelaxe@gmail.com
GAPSWISE_PUBLIC_DAILY_DEMO_LIMIT=50
GAPSWISE_PUBLIC_DAILY_ASK_LIMIT=30
# Public Ask fails closed until Firebase App Check is configured server-side.
FIREBASE_APPCHECK_ENABLED=false
# Optional isolated local data file. Defaults to .gapwise-data/mock-storage.json.
# GAPSWISE_MOCK_STORAGE_PATH=/tmp/gapwise-demo.json

# Firestore / Google Cloud
GOOGLE_CLOUD_PROJECT=gapwise-505217
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
# Firebase Admin can use Application Default Credentials from
# `gcloud auth application-default login`. Alternatively, provide all three
# service-account values below. Never commit real credential values.
# FIREBASE_PROJECT_ID=gapwise-505217
# FIREBASE_CLIENT_EMAIL=service-account@example.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
GEMINI_MODEL=gemini-3.5-flash-lite
# Four-agent policy. Keep cheap for local development; flagship is opt-in.
AGENT_MODEL_PROFILE=cheap
AGENT_CONTEXT_MODEL=gemini-3.5-flash-lite
AGENT_CONTEXT_THINKING=minimal
AGENT_CONTEXT_MAX_OUTPUT_TOKENS=1024
AGENT_GAP_MODEL=gemini-3.5-flash-lite
AGENT_GAP_THINKING=low
AGENT_GAP_MAX_OUTPUT_TOKENS=2048
# Gap rollout mode: deterministic makes no ADK call; shadow makes a paid call
# but preserves the deterministic result; live applies only validated ADK output.
GAP_AGENT_MODE=deterministic
AGENT_GAP_TIMEOUT_MS=22000
AGENT_ATTENTION_MODEL=gemini-3.5-flash-lite
AGENT_ATTENTION_THINKING=minimal
AGENT_ATTENTION_MAX_OUTPUT_TOKENS=1024
AGENT_PARTNER_MODEL=gemini-3.5-flash-lite
AGENT_PARTNER_THINKING=low
AGENT_PARTNER_MAX_OUTPUT_TOKENS=1024
# Gap escalation is opt-in and conservative. It only records a stronger retry
# candidate when close/high-impact/low-confidence reasoning warrants one.
AGENT_GAP_ESCALATION_ENABLED=false
AGENT_GAP_ESCALATION_MAX_RETRIES=1
AGENT_GAP_ESCALATION_MARGIN=0.05
AGENT_GAP_ESCALATION_LOW_CONFIDENCE=0.45
AGENT_GAP_ESCALATION_HIGH_IMPACT=0.90
AGENT_GAP_ESCALATION_COMPLEXITY=2
# Optional stronger override; otherwise the flagship Gap policy is used.
# AGENT_GAP_ESCALATION_MODEL=gemini-3.5-flash
# Optional live evaluation matrix. Overrides are accepted by the Python service
# only when GAP_AGENT_EVAL_OVERRIDES_ENABLED=true there.
# AGENT_GAP_EVAL_CHEAP_MODEL=gemini-3.5-flash-lite
# AGENT_GAP_EVAL_BALANCED_MODEL=gemini-3.5-flash
# AGENT_GAP_EVAL_STRONG_MODEL=gemini-3.5-flash
FIRESTORE_DATABASE_ID=(default)
CLOUD_STORAGE_BUCKET=gapwise-505217-context
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/calendar/callback
ATTENTION_RUN_SECRET=optional-internal-scheduler-secret
GAPSWISE_AGENT_URL=http://127.0.0.1:8080
# Public browser URL used after OAuth callbacks. Keep separate from the
# internal Cloud Run/agent service URL.
GAPSWISE_PUBLIC_WEB_URL=http://localhost:3000
# Set true only when the agent is a private HTTPS Cloud Run service.
GAPSWISE_AGENT_AUTH=false
# Shared only by the Next.js server and the trusted ADK service for internal
# Context Pack requests. Never expose this as NEXT_PUBLIC_*.
GAPSWISE_INTERNAL_API_SECRET=replace-with-a-long-random-secret

# Firebase Authentication web app configuration. These values are safe to
# expose to the browser; Firebase Security Rules and server token verification
# protect the data.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=gapwise-505217.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=gapwise-505217
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=gapwise-505217.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=your-recaptcha-v3-site-key

# Optional Gemini key for later milestones.
GEMINI_API_KEY=your-gemini-api-key
