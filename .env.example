# Zero-cost UX/development mode. This is a hard boundary that prevents calls to
# Firestore, Cloud Storage, Vertex/Gemini, ADK, Calendar, Gmail, and Drive.
GAPSWISE_DEMO_MODE=true

# Explicit local persistence. Demo mode also enforces this even if omitted.
USE_FIRESTORE=false
# Optional isolated local data file. Defaults to .gapwise-data/mock-storage.json.
# GAPSWISE_MOCK_STORAGE_PATH=/tmp/gapwise-demo.json

# Firestore / Google Cloud
GOOGLE_CLOUD_PROJECT=gapwise-505217
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-2.5-flash-lite
FIRESTORE_DATABASE_ID=(default)
CLOUD_STORAGE_BUCKET=gapwise-505217-context
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/calendar/callback
ATTENTION_RUN_SECRET=optional-internal-scheduler-secret
GAPSWISE_AGENT_URL=http://127.0.0.1:8080

# Optional Gemini key for later milestones.
GEMINI_API_KEY=your-gemini-api-key
