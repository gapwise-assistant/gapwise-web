# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EVAL_MODEL=gemini-3.5-flash-lite
# Four-agent model policy. The cheap profile is the default; use
# AGENT_MODEL_PROFILE=flagship only for a deliberate demo/evaluation run.
AGENT_MODEL_PROFILE=cheap
AGENT_CONTEXT_MODEL=gemini-3.5-flash-lite
AGENT_CONTEXT_THINKING=minimal
AGENT_CONTEXT_MAX_OUTPUT_TOKENS=1024
AGENT_GAP_MODEL=gemini-3.5-flash-lite
AGENT_GAP_THINKING=low
AGENT_GAP_MAX_OUTPUT_TOKENS=2048
AGENT_GAP_TIMEOUT_SECONDS=20
# Keep false in product traffic. Enable only while running the bounded local
# model-comparison command documented in docs/career-gap-evaluation.md.
GAP_AGENT_EVAL_OVERRIDES_ENABLED=false
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false
# Optional rates make estimatedCost numeric; omit them rather than guessing.
# AGENT_GAP_INPUT_COST_PER_MILLION=
# AGENT_GAP_OUTPUT_COST_PER_MILLION=
AGENT_ATTENTION_MODEL=gemini-3.5-flash-lite
AGENT_ATTENTION_THINKING=minimal
AGENT_ATTENTION_MAX_OUTPUT_TOKENS=1024
AGENT_PARTNER_MODEL=gemini-3.5-flash-lite
AGENT_PARTNER_THINKING=low
AGENT_PARTNER_MAX_OUTPUT_TOKENS=1024
# Conservative, opt-in Gap Agent escalation controls.
AGENT_GAP_ESCALATION_ENABLED=false
AGENT_GAP_ESCALATION_MAX_RETRIES=1
AGENT_GAP_ESCALATION_MARGIN=0.05
AGENT_GAP_ESCALATION_LOW_CONFIDENCE=0.45
AGENT_GAP_ESCALATION_HIGH_IMPACT=0.90
AGENT_GAP_ESCALATION_COMPLEXITY=2
# AGENT_GAP_ESCALATION_MODEL=gemini-3.5-flash
GAPSWISE_APP_URL=http://localhost:3000
# Must match the Next.js server value. Used only for trusted server-to-server
# Context Pack calls; never expose this to the browser.
GAPSWISE_INTERNAL_API_SECRET=replace-with-a-long-random-secret
GAPSWISE_DEFAULT_USER_ID=demo-user

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here
